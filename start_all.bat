@echo off
echo Starting AegisGAN Platform...

echo [1/5] Starting WSL Zeek Capture...
start "WSL Zeek" cmd /k wsl bash -lc "cd /mnt/e/AegisGAN/zeek_ws && ./run_zeek.sh eth0"

echo Waiting for WSL password/login...
timeout /t 15 /nobreak >nul

echo [2/5] Starting Main Backend...
start "Backend" cmd /k "python backend/main.py"

echo [3/5] Starting Frontend Dashboard...
start "Frontend" cmd /k "cd frontend && npm run dev"

echo [4/5] Starting Zeek Socket Bridge...
start "Zeek Bridge" cmd /k "python bridge/socket_sender.py --path zeek_ws/logs/conn.log --host 127.0.0.1"

echo [5/5] Starting Database Microservice...
start "Database Microservice" cmd /k "python db_microservice/main.py"

echo All services launched in separate windows!